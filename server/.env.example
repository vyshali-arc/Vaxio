# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vaxio_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=vaxio_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
